% ubthesis.sty, University of Buea PhD thesis formatting
% Implements report/UB-PhD-Thesis-Format-Spec.md
%
% Compile with pdflatex (Times clone via newtx) or xelatex/lualatex
% (real Times New Roman via fontspec). The class detects which.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ubthesis}[2026/08/16 University of Buea thesis format]

% ---------------------------------------------------------------------------
% 1. Page geometry, guide §3.1e
%    Left 3.5 cm (binding trim), 2.5 cm on the other three edges.
%    Header 1.5 cm into the page for the top-right folio.
% ---------------------------------------------------------------------------
\RequirePackage[
  a4paper,
  left=3.5cm, right=2.5cm, top=2.5cm, bottom=2.5cm,
  headheight=15pt, headsep=0.6cm,
  twoside=false
]{geometry}

% ---------------------------------------------------------------------------
% 2. Fonts, Times New Roman 12 pt (measured house style)
% ---------------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{newtxtext}   % Times clone for text
  \RequirePackage{newtxmath}   % matching maths
\else
  \RequirePackage{fontspec}
  \RequirePackage{unicode-math}
  \setmainfont{Times New Roman}[
    BoldFont       = Times New Roman Bold,
    ItalicFont     = Times New Roman Italic,
    BoldItalicFont = Times New Roman Bold Italic
  ]
  \setmathfont{TeX Gyre Termes Math}
\fi

% ---------------------------------------------------------------------------
% 3. Line spacing, guide §3.1c
%    Word's "Double" for TNR 12 pt is 27.6 pt baseline-to-baseline, i.e.
%    2.0 x the 13.8 pt single line height. setspace's \doublespacing gives
%    the same visual result. Quotations and footnotes stay single-spaced.
% ---------------------------------------------------------------------------
\RequirePackage{setspace}
% NOT \doublespacing. setspace's \doublespacing yields ~23.9 pt at 12 pt, but
% Word's "Double" for Times New Roman 12 pt is 27.6 pt baseline-to-baseline
% (2 x the 13.8 pt single line height), which is what the exemplar measures and
% what the examiners compare against. Set the stretch so the printed leading is
% 27.6 pt exactly.
\setstretch{1.911}
% No vertical space before or after paragraphs. Measured from the exemplar:
% every baseline gap in the body is 27.6 pt (one double-spaced line) with no
% paragraph gap anywhere. Paragraphs are separated by a first-line indent
% instead, otherwise double-spaced text with neither cue is unreadable.
\AtBeginDocument{%
  \setlength{\parskip}{0pt}%
  \setlength{\parindent}{1.27cm}%
}
\setlength{\topsep}{0pt}
\setlength{\partopsep}{0pt}
\RequirePackage{footmisc}
\renewcommand{\footnotelayout}{\singlespacing}

% Preliminary pages (dedication, acknowledgements, abstract, the front
% lists) are set at 1.5 lines, not the full double spacing the body uses.
% Same measured-not-assumed approach as \setstretch{1.911} above: Word's
% "1.5 lines" for Times New Roman 12 pt is 20.7 pt baseline-to-baseline
% (the 13.8 pt single line height times 1.5), i.e. \setstretch{1.4375}
% against the 14.4 pt single-spaced leading newtx/fontspec actually
% produces here. setspace's own \onehalfspacing assumes a plain 1.5
% multiplier and lands slightly off that target, so this is set directly.
\newenvironment{ubonehalfspace}{\begingroup\setstretch{1.4375}}{\par\endgroup}

% Block quotations: > 4 lines, indented 1.5 cm, single-spaced, no quote marks (§3.7)
\RequirePackage{quoting}
\quotingsetup{leftmargin=1.5cm, rightmargin=0pt, vskip=\baselineskip}
\renewenvironment{quotation}
  {\begin{quoting}\singlespacing}
  {\end{quoting}}

% ---------------------------------------------------------------------------
% 4. No hyphenation / no broken words at line ends, guide §3.1g
% ---------------------------------------------------------------------------
\RequirePackage[none]{hyphenat}
\sloppy
\hbadness=10000
\tolerance=9999
\emergencystretch=3em

% ---------------------------------------------------------------------------
% 5. Page numbers, top right, >= 1.5 cm into the page (guide §3.1f)
% ---------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
% Chapter opening pages use the same style, the guide wants a folio on every
% numbered page, unlike LaTeX's default empty first page.
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[R]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% ---------------------------------------------------------------------------
% 6. Heading hierarchy, measured from the exemplar
%
%    Chapter : "CHAPTER ONE" and the title, BOTH 16 pt bold, centred, on
%              consecutive single-spaced lines (18.4 pt apart in the exemplar).
%    Section : 14 pt bold, flush left, trailing period after the number
%              ("1.1.<tab>Context and Motivations").
%    Subsec  : 14 pt bold as well, not smaller ("1.3.1. Main Objective").
% ---------------------------------------------------------------------------
\RequirePackage{titlesec}

% \singlespacing inside the format is essential: without it \setstretch{1.911}
% multiplies the 18.4 pt leading up to ~35 pt and the two heading lines drift
% apart. The exemplar has them 18.4 pt apart, i.e. single-spaced.
\titleformat{\chapter}[display]
  {\normalfont\bfseries\centering\singlespacing\fontsize{16}{18.4}\selectfont}
  {\MakeUppercase{\chaptertitlename\ \thechapterword}}
  {0pt}
  {\MakeUppercase}
% After-space tuned so the first section heading lands ~39 pt below the chapter
% title, matching the exemplar.
\titlespacing*{\chapter}{0pt}{-25.6pt}{7pt}

% Trailing period after every section-level number, as in the exemplar.
\titleformat{\section}
  {\normalfont\fontsize{14}{16.8}\selectfont\bfseries}{\thesection.}{1em}{}
\titleformat{\subsection}
  {\normalfont\fontsize{14}{16.8}\selectfont\bfseries}{\thesubsection.}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\fontsize{12}{14.4}\selectfont\bfseries}{\thesubsubsection.}{1em}{}

% Exemplar spacing: ~39 pt above a section heading, ~30 pt below.
\titlespacing*{\section}{0pt}{13pt}{3pt}
\titlespacing*{\subsection}{0pt}{1.2\baselineskip}{0.4\baselineskip}
\titlespacing*{\subsubsection}{0pt}{1.0\baselineskip}{0.3\baselineskip}

% Soft (unnumbered, lettered) sub-headings, as the exemplar uses inside its
% Chapter Two: "a) Machine Learning Approaches" at 14 pt bold, flush left,
% carrying no section number and not competing with the numbered hierarchy.
% They group thematic material inside one numbered section instead of
% inflating the chapter into a long flat run of numbered sections.
% Listed in the ToC at subsection depth so the reader can still find them.
% \theubsoft carries the parent section too, so a \ref to a soft heading reads
% "Section 2.2(b)" rather than a bare "Section b". The heading itself prints
% only the letter, which is what the exemplar shows.
\newcounter{ubsoft}[section]
\renewcommand{\theubsoft}{\thesection(\alph{ubsoft})}
\newcommand{\ubsoft}[1]{%
  \par\refstepcounter{ubsoft}%
  \addcontentsline{toc}{subsection}{\protect\numberline{\alph{ubsoft})}#1}%
  \vspace{0.9\baselineskip}%
  \noindent{\normalfont\fontsize{14}{16.8}\selectfont\bfseries\alph{ubsoft}) #1}%
  \par\vspace{0.3\baselineskip}\nopagebreak
}

% Spell chapter numbers as words: CHAPTER ONE, CHAPTER TWO, ...
\RequirePackage{fmtcount}
\newcommand{\thechapterword}{\NUMBERstring{chapter}}

% \tableofcontents, \listoffigures and \listoftables are the only starred
% chapters (\chapter*) this document uses. Two independent title-making
% mechanisms sit behind them and both had to be found: book.cls's stock
% \@makeschapterhead (\vspace*{50pt}, an empty \Huge heading line, \vskip
% 40pt) is superseded the moment tocloft loads, because tocloft's own
% \AtBeginDocument hook (fired below, since tocloft is required further
% down) redefines \tableofcontents/\listoffigures/\listoftables to call
% \@cftmaketoctitle/\@cftmakeloftitle/\@cftmakelottitle instead, which
% reimplement the exact same 50pt+40pt band (\cftbeforetoctitleskip,
% \cftaftertoctitleskip, ...) independently of \@makeschapterhead. With
% \listfigurename etc. redefined to {} in main.tex that ~150pt band (more
% once \Huge is stretched by \setstretch{1.911} above) prints nothing,
% leaving a large blank gap between our own \ubfrontheading title and the
% first entry. Both are suppressed here; every \chapter* in this document
% is already preceded by \ubfrontheading, so neither built-in heading is
% needed.
\makeatletter
\renewcommand{\@makeschapterhead}[1]{}
\AtBeginDocument{%
  \renewcommand{\@cftmaketoctitle}{}%
  \renewcommand{\@cftmakeloftitle}{}%
  \renewcommand{\@cftmakelottitle}{}%
}
\makeatother

% ---------------------------------------------------------------------------
% 7. Front-matter headings (DEDICATION, ABSTRACT, ...) at 16 pt bold caps
% ---------------------------------------------------------------------------
\newcommand{\ubfrontheading}[1]{%
  \phantomsection
  \begin{center}
    {\normalfont\fontsize{16}{19}\selectfont\bfseries\MakeUppercase{#1}}
  \end{center}
  \vspace{\baselineskip}
}

% ---------------------------------------------------------------------------
% 8. Captions, 12 pt, italic label, per the exemplar
% ---------------------------------------------------------------------------
\RequirePackage[font={singlespacing,normalsize}, labelfont={normalfont},
                textfont={normalfont}, labelsep=period,
                justification=centering]{caption}
% Continuous figure and table numbering (Figure 1, 2, 3 ...), not per chapter.
\RequirePackage{chngcntr}
\AtBeginDocument{\counterwithout{figure}{chapter}\counterwithout{table}{chapter}}

% ---------------------------------------------------------------------------
% 9. Table of contents depth and dotted leaders
% ---------------------------------------------------------------------------
\setcounter{tocdepth}{2}
\setcounter{secnumdepth}{3}
\RequirePackage{tocloft}
\renewcommand{\cftdot}{.}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftchapfont}{\bfseries}

% List of Figures / List of Tables: entries read "Figure 1  ..." and
% "Table 1  ..." rather than a bare number, matching how the figures and
% tables are actually labelled in the text.
\renewcommand{\cftfigpresnum}{\figurename~}
\renewcommand{\cftfigaftersnumb}{\quad}
\settowidth{\cftfignumwidth}{\figurename~88\quad}
\renewcommand{\cfttabpresnum}{\tablename~}
\renewcommand{\cfttabaftersnumb}{\quad}
\settowidth{\cfttabnumwidth}{\tablename~88\quad}

% Submission month and year for the title page (guide §3.2.1 vii)
\newcommand{\monthyear}{\ifcase\month\or January\or February\or March\or
  April\or May\or June\or July\or August\or September\or October\or
  November\or December\fi\space\number\year}

% ---------------------------------------------------------------------------
% 10. Common utilities
% ---------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{tikz}
\usetikzlibrary{positioning, arrows.meta, shapes.geometric, fit, backgrounds, calc}
% pgfplots for the bar charts in Chapters Two and Four. compat pinned so the
% axis code does not change meaning when the package is upgraded.
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
% newtxmath already defines \Bbbk; let amssymb redefine it without erroring.
\let\Bbbk\relax
\RequirePackage{amsmath,amssymb}
\RequirePackage{float}
\RequirePackage{enumitem}
\setlist{itemsep=0pt, parsep=0.4\baselineskip, topsep=0.4\baselineskip}
\RequirePackage{siunitx}
\DeclareSIUnit{\tps}{TPS}          % transactions per second
\DeclareSIUnit{\ha}{ha}            % hectare
\RequirePackage[hidelinks]{hyperref}
\hypersetup{
  bookmarksnumbered=true,
  pdfstartview=FitH
}
% Font consistency across every page: hyperref and biblatex set URLs and DOIs
% in a typewriter face by default, which puts a second font family into the
% bibliography. Force the roman face so the whole document is Times.
\urlstyle{same}
\renewcommand{\UrlFont}{\rmfamily}
\AtBeginDocument{\renewcommand{\ttdefault}{\rmdefault}}

\endinput
